# ============================================================
# SKM Tooling Center — Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ---- App ----
APP_NAME="SKM Tooling Center"
APP_VERSION="1.0.0"
DEBUG=false

# ---- Security ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_256_BIT_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database ----
# SQLite (development default – uses a local file):
DATABASE_URL=sqlite:///./skm_tooling.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@DB_HOST:5432/skm_tooling

# ---- CORS (comma-separated for production) ----
# ALLOWED_ORIGINS=["https://yourdomain.com"]

# ---- Email (optional – enquiry storage works without this) ----
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# ---- File Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Rate Limiting ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
